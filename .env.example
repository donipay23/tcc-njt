# Salin menjadi .env.local (development) atau isi di Environment Variables Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# RAHASIA — hanya di server, jangan pernah diawali NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# URL publik aplikasi (untuk link reset password)
NEXT_PUBLIC_SITE_URL=https://[ISI-domain]
# Nama aplikasi (PWA)
NEXT_PUBLIC_APP_NAME=Manpower Bontang
